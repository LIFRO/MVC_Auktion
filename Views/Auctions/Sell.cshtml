@model MVC_Auktioner.Models.SellAuctionModel
@{
    ViewData["Title"] = "Sell Auction";
}

<h1>Sell Auction</h1>

<form asp-action="Sell" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="InventoryId"></label>
        <input asp-for="InventoryId" class="form-control" readonly />
        <span asp-validation-for="InventoryId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StartingPrice"></label>
        <div class="form-control-plaintext">@Model.StartingPrice</div>
    </div>

    <div class="form-group">
        <label asp-for="FinalPrice"></label>
        <input asp-for="FinalPrice" class="form-control" />
        <span asp-validation-for="FinalPrice" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Mark as sold</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back to list</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
