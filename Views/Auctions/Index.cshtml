@model IEnumerable<MVC_Auktioner.Models.AuctionModel>
@{
    ViewData["Title"] = "Auktioner";
}

<h1>Auktioner</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create auction</a>
    <a asp-controller="Home" asp-action="index" class="btn btn-primary">Back</a>
</p>

@if (!Model.Any())
{
    <p>No auctions yet</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>InventoryId</th>
            <th>Title</th>
            <th>Decade</th>
            <th>Category</th>
            <th>PurchaseCost</th>
            <th>StartingPrice</th>
            <th>Sold</th>
            <th>FinalPrice</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var auction in Model)
        {
            <tr>
                <td>@auction.InventoryId</td>
                <td>@auction.Title</td>
                <td>@auction.Decade</td>
                <td>@auction.Category</td>
                <td>@auction.PurchaseCost</td>
                <td>@auction.StartingPrice</td>
                @{if (auction.Sold == true)
                {
                    <td>Sold</td>
                }
                else {
                    <td>Not sold</td>
                }
                }
                <td>@auction.FinalPrice</td>
                @{if (auction.Sold == false)
                {
                <td><a asp-action="Sell" asp-route-id="@auction.Id" class="btn btn-primary">Not Sold</a></td>
                }
                else 
                {
                    <td>Sold</td>
                }
                }
            </tr>
        }
        </tbody>
    </table>
}
